    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "dompurify": "^3.5.0",
    "electron": "^44.11.5",
    "electron-builder": "^26.18.1",
    "esbuild": "^0.25.12",
    "fflate": "^0.8.3",
    "lucide-react": "^0.577.0",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^5.7.284",
    "playwright": "^1.63.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^6.30.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vitest": "^3.2.7",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^3.25.76"
  }
}
