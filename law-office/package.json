{
  "name": "law-office-manager",
  "productName": "LawOfficeManager",
  "version": "1.0.0",
  "description": "برنامج محلي لإدارة مكتب المحاماة والتوثيق والاستشارات القانونية",
  "author": "Law Office Manager",
  "license": "UNLICENSED",
  "private": true,
  "main": "dist/main/main.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "electron .",
    "e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "pack:linux": "npm run build && electron-builder --linux dir",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "dist:win-arm64": "npm run build && electron-builder --win nsis --arm64",
    "build:mobile": "node scripts/build-mobile.mjs --sync",
    "test:sqljs": "vitest run -c vitest.sqljs.config.ts"
  },
  "devDependencies": {
    "@capacitor/app": "^7.1.2",
    "@capacitor/cli": "^7.6.10",
    "@capacitor/core": "^7.6.10",
    "@capacitor/filesystem": "^7.1.9",
    "@capacitor/ios": "^7.6.10",
    "@capacitor/share": "^7.0.4",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@noble/hashes": "^1.8.0",
    "@supabase/supabase-js": "^2.119.2",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.16.1",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "buffer": "^6.0.3",
    "dompurify": "^3.5.0",
    "electron": "^44.11.5",
    "electron-builder": "^26.18.1",
    "esbuild": "^0.25.12",
    "fflate": "^0.8.3",
    "law-native": "file:native/law-native",
    "lucide-react": "^0.577.0",
    "mammoth": "^1.13.0",
    "path-browserify": "^1.0.1",
    "pdfjs-dist": "^5.7.284",
    "pg": "^8.23.1",
    "playwright": "^1.63.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^6.30.6",
    "sql.js": "^1.17.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vitest": "^3.2.7",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^3.25.76"
  }
